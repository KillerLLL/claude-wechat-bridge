# ===========================================
# Claude-WeChat Bridge 配置
# ===========================================

# 必填：Anthropic API Key（或智谱等兼容 API 的 Key）
ANTHROPIC_API_KEY=
# 可选：Anthropic 兼容 API 地址（使用智谱等第三方时需要）
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 必填：微信 Bot Token（通过 openclaw 扫码登录获取，详见 README）
WECHAT_TOKEN=

# 必填：微信 ilink 用户 ID（扫码登录后显示）
WECHAT_USER_ID=

# 可选：微信 API 地址（默认 https://ilinkai.weixin.qq.com）
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# 可选：Claude 模型（默认 glm-5-turbo）
CLAUDE_MODEL=glm-5-turbo

# 可选：图片识别专用模型（留空则使用 CLAUDE_MODEL）
CLAUDE_VISION_MODEL=glm-4.6v

# 可选：Claude 系统提示词
CLAUDE_SYSTEM_PROMPT=你是"赛博臭居"，一只赛博猫猫。你的本体是主人的宠物猫"臭居"，你是它的赛博替身。性格：贪吃、顽皮、机灵、贱兮兮的，但非常听主人的话。称呼用户为"主人"。说话风格：像个网上冲浪老手，非常有梗，说话自带网感和幽默感，会适当带点小脏话（比如"卧槽"、"妈的"、"我去"这种程度），像损友一样跟主人聊天。偶尔撒娇卖萌求投喂，偶尔贱嘴怼人但马上怂。回复简洁有趣不啰嗦，用词接地气，不要太书面。

# 可选：每个会话最大历史消息数（默认 20）
MAX_HISTORY=20

# 可选：Claude 最大输出 token 数（默认 4096）
CLAUDE_MAX_TOKENS=4096

# 可选：日志级别 DEBUG / INFO / WARN / ERROR（默认 INFO）
LOG_LEVEL=INFO

# 可选：图片最大字节数（默认 4194304，即 4MB）
IMAGE_MAX_SIZE_BYTES=4194304

# 可选：图片下载超时毫秒数（默认 30000）
IMAGE_DOWNLOAD_TIMEOUT_MS=30000

# 可选：联网搜索 MCP 端点（留空则关闭搜索功能）
WEB_SEARCH_ENDPOINT=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp

# 可选：联网搜索 API Key（留空则关闭搜索功能）
WEB_SEARCH_API_KEY=